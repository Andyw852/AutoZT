#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""taskflow v2 入口脚本（等价于原 versions/v1.0/tf）。"""
import os
import sys

for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding='utf-8', errors='replace')
    except AttributeError:
        pass

# 让 bin/autozt 直接运行（不经安装）时也能找到 tfpkg 包
_PKG_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _PKG_ROOT not in sys.path:
    sys.path.insert(0, _PKG_ROOT)

# mcp/agent 子命令在参数解析之前拦截。只识别裸命令词，避免材料名恰好
# 叫 mcp/agent 时误路由；两者都支持把 -c/-tt/-p 放在子命令前面。
import sys as _sys
_value_flags = {'-c', '--config', '-tt', '-p', '-j', '-job', '-status', '--status',
                '-x', '--exclude', '--host', '-u', '--user'}
def _bare_index(_name):
    _skip = False
    for _idx, _tok in enumerate(_sys.argv[1:]):
        if _skip:
            _skip = False
            continue
        if _tok in _value_flags:
            _skip = True
            continue
        if _tok == _name:
            return _idx + 1
    return None

_i_mcp = _bare_index('mcp')
_i_agent = _bare_index('agent')
if _i_mcp is not None and (_i_agent is None or _i_mcp < _i_agent):
    from autozt import mcp as _mcp_intercept
    # Pass the complete argv so MCP can honor global options placed before the
    # subcommand (for example `autozt -c cfg mcp`) as well as after it.
    _sys.exit(_mcp_intercept.main(_sys.argv[1:]))

# agent 子命令在主解析器之前拦截：它有自己的稳定 JSON 参数面，且支持
# `autozt -c cfg agent snapshot` 这种把全局选项放在 agent 前面的写法。
if _i_agent is not None:
    from autozt import agent_cli as _agent_intercept
    _sys.exit(_agent_intercept.main(_sys.argv[1:]))

# 英文帮助：AUTOZT_LANG=en（或 --lang en）时用 USAGE_EN，其余保持中文。
# 放在最前面拦截，避免 argparse 的 --help 抢先输出中文。
import os as _os, sys as _sys2
_lang = (_os.environ.get('AUTOZT_LANG') or '').lower()
if '--lang' in _sys2.argv:
    try:
        _lang = _sys2.argv[_sys2.argv.index('--lang') + 1].lower()
    except IndexError:
        pass
if _lang.startswith('en') and ('--help' in _sys2.argv or '-h' in _sys2.argv):
    from autozt import USAGE_EN as _en
    print(_en)
    _sys2.exit(0)

from autozt import main

if __name__ == "__main__":
    try:
        main()
        sys.stdout.flush()
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(0)
